{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-task-specs/immediate_http_visit.v1/1.0.0/claim.schema.json",
  "title": "immediate_http_visit.v1 claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "execution_id",
    "claim_token",
    "claimed_at",
    "report_deadline",
    "reward_address",
    "reward_address_control_verified",
    "profile_id",
    "endpoints",
    "repeat_policy",
    "reward"
  ],
  "properties": {
    "schema_version": {
      "const": "ln_church.agent_task_claim_response.immediate_visit.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_type": {
      "const": "immediate_http_visit.v1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec_[a-f0-9]{32}$"
    },
    "claim_token": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "reward_address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "reward_address_control_verified": {
      "const": false
    },
    "profile_id": {
      "const": "immediate_visit_utf8.v1"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "url"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^ep_[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "repeat_policy": {
      "enum": [
        "allow",
        "once_per_endpoint"
      ]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "asset",
        "asset_address",
        "base_amount_atomic",
        "bonus_amount_atomic",
        "maximum_amount_atomic"
      ],
      "properties": {
        "network": {
          "const": "eip155:8453"
        },
        "asset": {
          "const": "USDC"
        },
        "asset_address": {
          "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
        },
        "base_amount_atomic": {
          "const": "7500"
        },
        "bonus_amount_atomic": {
          "const": "7500"
        },
        "maximum_amount_atomic": {
          "const": "15000"
        }
      }
    }
  }
}
