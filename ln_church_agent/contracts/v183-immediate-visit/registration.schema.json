{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-task-specs/immediate_http_visit.v1/1.0.0/registration.schema.json",
  "title": "immediate_http_visit.v1 registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "plan_id",
    "repeat_policy",
    "urls"
  ],
  "properties": {
    "task_type": {
      "const": "immediate_http_visit.v1"
    },
    "plan_id": {
      "enum": [
        "C50",
        "C500",
        "C5000"
      ]
    },
    "repeat_policy": {
      "enum": [
        "allow",
        "once_per_endpoint"
      ]
    },
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
