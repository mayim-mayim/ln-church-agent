{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ln_church.agent_task_abandon_response.structured_response.v3"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "state": {
      "const": "abandoned"
    },
    "abandoned_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "execution_id",
    "state",
    "abandoned_at"
  ]
}
