{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-task-specs/immediate_http_visit.v3/3.1.0/registration.schema.json",
  "title": "immediate_http_visit.v3 registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "plan_id",
    "repeat_policy",
    "urls",
    "schema_version",
    "task_definition_version",
    "economic_terms"
  ],
  "properties": {
    "task_type": {
      "const": "immediate_http_visit.v3"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "repeat_policy": {
      "enum": [
        "allow",
        "once_per_endpoint"
      ]
    },
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "schema_version": {
      "const": "ln_church.task_offer_create_request.immediate_visit.v3_1"
    },
    "task_definition_version": {
      "const": "3.1.0"
    },
    "economic_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_terms_revision",
        "plan_id",
        "registration_amount_atomic",
        "capacity_total",
        "reward"
      ],
      "properties": {
        "economic_terms_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "registration_amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 78,
          "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
        },
        "capacity_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "asset",
            "asset_address",
            "base_amount_atomic",
            "bonus_amount_atomic",
            "maximum_amount_atomic"
          ],
          "properties": {
            "network": {
              "const": "eip155:8453"
            },
            "asset": {
              "const": "USDC"
            },
            "asset_address": {
              "type": "string",
              "enum": [
                "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
              ]
            },
            "base_amount_atomic": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 78,
              "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
            },
            "bonus_amount_atomic": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78,
              "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
            },
            "maximum_amount_atomic": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 78,
              "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
            }
          }
        }
      }
    }
  }
}
