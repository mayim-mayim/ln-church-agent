{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-task-specs/immediate_http_visit.v3/3.1.0/task.schema.json",
  "title": "immediate_http_visit.v3 task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "status",
    "published_at",
    "listing_ends_at",
    "plan_id",
    "registration_amount_atomic",
    "repeat_policy",
    "capacity_total",
    "capacity_reserved",
    "capacity_consumed",
    "capacity_available",
    "definition_version",
    "profile_id",
    "endpoints",
    "reward",
    "definition_url",
    "summary_url",
    "results_url",
    "economic_terms_revision",
    "terms_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "ln_church.agent_task.immediate_visit.v3_1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_type": {
      "const": "immediate_http_visit.v3"
    },
    "status": {
      "enum": [
        "OPEN",
        "LISTING_ENDED",
        "CLOSED"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "listing_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "registration_amount_atomic": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "repeat_policy": {
      "enum": [
        "allow",
        "once_per_endpoint"
      ]
    },
    "capacity_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capacity_reserved": {
      "type": "integer",
      "minimum": 0
    },
    "capacity_consumed": {
      "type": "integer",
      "minimum": 0
    },
    "capacity_available": {
      "type": "integer",
      "minimum": 0
    },
    "definition_version": {
      "const": "3.1.0"
    },
    "profile_id": {
      "const": "immediate_visit_utf8.v3"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "url"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^ep_[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "asset",
        "asset_address",
        "base_amount_atomic",
        "bonus_amount_atomic",
        "maximum_amount_atomic"
      ],
      "properties": {
        "network": {
          "const": "eip155:8453"
        },
        "asset": {
          "const": "USDC"
        },
        "asset_address": {
          "type": "string",
          "enum": [
            "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
          ]
        },
        "base_amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 78
        },
        "bonus_amount_atomic": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maximum_amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 78
        }
      }
    },
    "definition_url": {
      "type": "string",
      "format": "uri"
    },
    "summary_url": {
      "type": "string",
      "format": "uri"
    },
    "results_url": {
      "type": "string",
      "format": "uri"
    },
    "economic_terms_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "terms_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
