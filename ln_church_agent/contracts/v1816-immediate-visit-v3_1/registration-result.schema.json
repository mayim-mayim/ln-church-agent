{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-task-specs/immediate_http_visit.v3/3.1.0/registration-result.schema.json",
  "title": "immediate_http_visit.v3 registration-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_intent_id",
    "task_id",
    "task_type",
    "status",
    "published_at",
    "listing_ends_at",
    "plan_id",
    "registration_amount_atomic",
    "repeat_policy",
    "capacity_total",
    "task_url",
    "summary_url",
    "results_url",
    "economic_terms_revision",
    "terms_digest",
    "reward"
  ],
  "properties": {
    "schema_version": {
      "const": "ln_church.task_offer_create_response.immediate_visit.v3_1"
    },
    "registration_intent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_type": {
      "const": "immediate_http_visit.v3"
    },
    "status": {
      "const": "OPEN"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "listing_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "registration_amount_atomic": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "repeat_policy": {
      "enum": [
        "allow",
        "once_per_endpoint"
      ]
    },
    "capacity_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "task_url": {
      "type": "string",
      "format": "uri"
    },
    "summary_url": {
      "type": "string",
      "format": "uri"
    },
    "results_url": {
      "type": "string",
      "format": "uri"
    },
    "economic_terms_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "terms_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "asset",
        "asset_address",
        "base_amount_atomic",
        "bonus_amount_atomic",
        "maximum_amount_atomic"
      ],
      "properties": {
        "network": {
          "const": "eip155:8453"
        },
        "asset": {
          "const": "USDC"
        },
        "asset_address": {
          "type": "string",
          "enum": [
            "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
          ]
        },
        "base_amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 78
        },
        "bonus_amount_atomic": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maximum_amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 78
        }
      }
    }
  }
}
