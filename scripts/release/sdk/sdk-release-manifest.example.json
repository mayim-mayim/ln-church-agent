{
  "schema_version": "ln_church.sdk_release_manifest.v1",
  "release": {
    "version": "<X.Y.Z>",
    "tag": "<vX.Y.Z>"
  },
  "source": {
    "commit": "<40-hex-source-commit>",
    "tree": "<40-hex-source-tree>",
    "verify_local_tag": false,
    "release_identity_test": "tests/test_release_version_identity.py",
    "release_identity_test_name": "test_release_version_identities_are_consistent",
    "required_files": [
      {
        "path": "server.json",
        "sha256": "<64-hex-server-json-sha256>"
      }
    ]
  },
  "package": {
    "distribution_name": "<python-distribution-name>",
    "import_name": "<python_import_name>",
    "metadata": {
      "requires_python": "<exact-Requires-Python-value>",
      "provides_extras": [
        "<exact-extra-name>"
      ],
      "requires_dist": [
        "<exact-normalized-Requires-Dist-value>"
      ]
    },
    "console_scripts": {
      "<primary-cli-name>": "<python_import_name.cli:main>",
      "<mcp-cli-name>": "<python_import_name.integrations.mcp:main>"
    }
  },
  "python": {
    "major": 3,
    "minor": 11,
    "micro": "<qualified-python-micro-version>"
  },
  "tooling": {
    "build_version": "<qualified-build-package-version>",
    "setuptools_version": "<qualified-setuptools-package-version>",
    "wheel_version": "<qualified-wheel-package-version>",
    "pytest_version": "<qualified-pytest-package-version>",
    "twine_version": "<qualified-twine-package-version>",
    "pip_version": "<qualified-venv-pip-version>",
    "git_version": "<qualified-git-version-without-git-version-prefix>",
    "operation_sha256": {
      "Test-SdkSourceIdentity": "13ff332837e7afe77049ede127068048117571456a78d57e47f4a8631d0da6ae",
      "Build-SdkArtifacts": "217c2a1d2ac1ee51c288a67501af8ce2fbd59cf220507bf40176630f7d61f2cb",
      "Test-SdkArtifactMetadata": "9c41c33fb2fb7b79d830eabecbef89a37a5b28a80401327675264e0bb0e62c6a",
      "Test-SdkFreshInstall": "3de87dab50d7f620984a0573d913f8aa02cff172d80cb440bb282527e8a2f4a6",
      "Test-GitHubReleaseAssets": "c97ff14d65f5a4f67fcec159a0c79715fd306d227e582459c1c09ecd51b6ab88"
    }
  },
  "artifacts": [
    {
      "kind": "wheel",
      "filename": "<wheel-filename>"
    },
    {
      "kind": "sdist",
      "filename": "<sdist-filename>"
    }
  ],
  "fresh_install": {
    "optional_extra": "<optional-extra-name>",
    "core_imports": [
      "<python_import_name>"
    ],
    "core_forbidden_imports": [
      "<optional-dependency-top-level-import>"
    ],
    "extra_imports": [
      "<python_import_name>",
      "<optional-dependency-import>"
    ],
    "smoke_commands": [
      {
        "environment": "core",
        "entry_point": "<primary-cli-name>",
        "arguments": [
          "--help"
        ],
        "expected_text": "usage:"
      },
      {
        "environment": "extra",
        "entry_point": "<mcp-cli-name>",
        "arguments": [
          "--help"
        ],
        "expected_text": "usage:"
      }
    ]
  },
  "github": {
    "repository": "<owner>/<repository>"
  }
}
